{
  "name": "metsuki-premium-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "generate:og": "node scripts/generate-og-image.mjs",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "build:main": "vite build",
    "dev": "vite",
    "build": "npm run generate:og && npm run typecheck && npm run build:main",
    "preview": "vite preview",
    "test": "vitest run cloudflare/test",
    "test:e2e": "playwright test",
    "cf:dev": "wrangler dev --config cloudflare/wrangler.jsonc",
    "cf:typecheck": "tsc --noEmit -p cloudflare/tsconfig.json",
    "cf:migrate:local": "wrangler d1 migrations apply kagami-nexus --local --config cloudflare/wrangler.jsonc",
    "cf:import": "node cloudflare/scripts/convert-supabase-export.mjs",
    "validate": "npm run typecheck && npm run cf:typecheck && npm test"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.17",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.86.0"
  }
}
